# Credentials stay in the local .env file. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Paid inference is selected explicitly by the demo command or --provider openai.
# Replay and tests stay keyless. These limits are enforced before paid requests.
OTT_AGENT_LIVE_RUN_BUDGET_USD=0.50
OTT_AGENT_LIVE_TOTAL_BUDGET_USD=1.00
OTT_AGENT_MAX_INPUT_TOKENS=16000
OTT_AGENT_MAX_OUTPUT_TOKENS=1800
